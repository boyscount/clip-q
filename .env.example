# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — .env ถูก gitignore ไว้แล้ว
# ตรวจว่าตั้งถูกไหมด้วย:  python -m server.doctor


# ───────────────────────────────────────────────────────────────
# 1. Shopee Affiliate  (จำเป็น ถ้าจะดึงสินค้าจริงและดูว่าคลิปไหนทำเงิน)
#    ได้จาก Shopee Open Platform > My Apps
# ───────────────────────────────────────────────────────────────
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# th | my | sg | vn | ph | id | tw | br
SHOPEE_REGION=th


# ───────────────────────────────────────────────────────────────
# 2. โฟลเดอร์ส่งคลิปเข้ามือถือ  (ไม่ใส่ = ปิดฟีเจอร์)
#    ชี้ไปที่โฟลเดอร์ที่ Syncthing / Google Drive / OneDrive ซิงก์อยู่
#    แล้วคลิปที่เรนเดอร์เสร็จจะไปโผล่ในมือถือเอง พร้อมไฟล์ .txt ที่มีแคปชัน
# ───────────────────────────────────────────────────────────────
CLIPQUEUE_OUTBOX=
# เก็บไว้กี่คลิปในโฟลเดอร์นั้น (เก่ากว่านี้จะถูกลบ)
CLIPQUEUE_OUTBOX_KEEP=60


# ───────────────────────────────────────────────────────────────
# 3. แจ้งเตือนเข้ามือถือ  (ไม่ใส่ = ปิด)
#    เลือกอย่างใดอย่างหนึ่ง: ntfy | telegram | discord | none
# ───────────────────────────────────────────────────────────────
CLIPQUEUE_NOTIFY=none

# --- ถ้าเลือก ntfy (ง่ายสุด ไม่ต้องสมัครอะไร) ---
#   1. ติดตั้งแอป ntfy ในมือถือ
#   2. ตั้งชื่อหัวข้อยาว ๆ เดาไม่ได้ แล้ว subscribe ในแอป
#      (ใครรู้ชื่อหัวข้อก็เห็นข้อความได้ ตั้งให้เดายาก)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- ถ้าเลือก telegram ---
#   1. ทักหา @BotFather ในเทเลแกรม พิมพ์ /newbot แล้วเอา token มาใส่
#   2. ทักบอทที่เพิ่งสร้างสักข้อความ แล้วเปิด
#      https://api.telegram.org/bot<TOKEN>/getUpdates เพื่อดู chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ถ้าเลือก discord ---
#   ตั้งค่าห้อง > Integrations > Webhooks > New Webhook แล้วคัดลอก URL มา
DISCORD_WEBHOOK_URL=

# ลิงก์ที่จะแนบไปในแจ้งเตือน — ต้องเป็น URL ที่มือถือเปิดถึง
# ถ้าอยู่วง Wi-Fi เดียวกัน ใส่ IP ของเครื่องที่รันเซิร์ฟเวอร์ เช่น http://192.168.1.50:8787
CLIPQUEUE_BASE_URL=http://127.0.0.1:8787


# ───────────────────────────────────────────────────────────────
# 4. ให้ Claude เขียนจุดขายสินค้า  (ไม่ใส่ก็ได้ จะใช้ยอดขาย/เรตติ้งแทน)
# ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
